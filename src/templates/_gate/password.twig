{# Bouncer's built-in password prompt.

   Deliberately a standalone document with its own inline CSS rather than an asset bundle: this
   renders on the front end, in place of the protected page, and registering a bundle here would
   let every other installed plugin inject its chrome into it. A site that wants its own design
   points the "Password template" setting at a site template instead. #}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ message ?? "Password required"|t('bouncer') }}</title>
    <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: #f4f5f7;
            color: #1a1d21;
        }
        .gate {
            width: 100%;
            max-width: 24rem;
            background: #fff;
            border-radius: 10px;
            padding: 2rem;
            box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 8px 24px rgba(0,0,0,.06);
        }
        h1 { margin: 0 0 .5rem; font-size: 1.25rem; }
        p { margin: 0 0 1.25rem; color: #5b6472; }
        label { display: block; font-weight: 600; margin-bottom: .35rem; font-size: .875rem; }
        input[type="password"] {
            width: 100%; padding: .625rem .75rem; font-size: 1rem;
            border: 1px solid #c8cdd4; border-radius: 6px; background: #fff; color: inherit;
        }
        input[type="password"]:focus { outline: 2px solid #2563eb; outline-offset: 1px; border-color: #2563eb; }
        button {
            margin-top: 1rem; width: 100%; padding: .65rem 1rem; font-size: 1rem; font-weight: 600;
            border: 0; border-radius: 6px; background: #1a1d21; color: #fff; cursor: pointer;
        }
        button:hover { background: #333941; }
        .error { margin: 0 0 1rem; padding: .625rem .75rem; border-radius: 6px; background: #fdecec; color: #8f1d1d; font-size: .9375rem; }
        @media (prefers-color-scheme: dark) {
            body { background: #14171a; color: #e8eaed; }
            .gate { background: #1e2226; box-shadow: none; border: 1px solid #2c3238; }
            p { color: #9aa3ad; }
            input[type="password"] { background: #14171a; border-color: #3a424a; }
            button { background: #e8eaed; color: #14171a; }
            .error { background: #3a1d1d; color: #f5b5b5; }
        }
    </style>
</head>
<body>
    <main class="gate">
        <h1>{{ "Password required"|t('bouncer') }}</h1>

        {% if message %}
            <p>{{ message }}</p>
        {% else %}
            <p>{{ "This page is protected. Enter the password to continue."|t('bouncer') }}</p>
        {% endif %}

        {% set flash = craft.app.session.getFlash('error') %}
        {% if flash %}
            <p class="error">{{ flash }}</p>
        {% endif %}

        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            <input type="hidden" name="action" value="bouncer/gate/submit">
            <input type="hidden" name="rule" value="{{ rule.handle }}">
            {{ redirectInput(craft.app.request.pathInfo) }}

            <label for="bouncer-password">{{ "Password"|t('bouncer') }}</label>
            <input type="password" id="bouncer-password" name="password" autocomplete="current-password" autofocus required>

            <button type="submit">{{ "Continue"|t('bouncer') }}</button>
        </form>
    </main>
</body>
</html>
